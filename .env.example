# Configuración de la aplicación
APP_NAME="Repositorio Digital ISTAE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/RepoIstae/public

# Base de Datos (XAMPP local)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=repositorio_istae
DB_USERNAME=root
DB_PASSWORD=

# Correo (desarrollo - log driver)
MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="repositorio@istae.edu.ec"
MAIL_FROM_NAME="${APP_NAME}"

# Cache y Sesiones (file para desarrollo local)
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

# Almacenamiento
FILESYSTEM_DISK=public

# Límite de subida de archivos (en KB)
MAX_UPLOAD_SIZE=51200
